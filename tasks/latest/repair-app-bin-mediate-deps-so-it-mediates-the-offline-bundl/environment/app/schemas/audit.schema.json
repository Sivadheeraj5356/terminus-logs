{
  "title": "audit.json",
  "type": "object",
  "required": ["summary", "by_reason", "license_summary", "outputs"],
  "properties": {
    "summary": {
      "type": "object",
      "required": [
        "run_id",
        "root_count",
        "selected_count",
        "classpath_count",
        "finding_count",
        "fatal"
      ]
    },
    "by_reason": {
      "type": "object",
      "description": "All fifteen reason keys with integer counts"
    },
    "license_summary": {
      "type": "object",
      "additionalProperties": {
        "type": "object",
        "required": ["selected_count", "classpath_count", "status"]
      }
    },
    "outputs": {
      "type": "object",
      "required": ["classpath_csv", "mediation_csv", "findings_csv"]
    }
  },
  "propertyOrder": ["summary", "by_reason", "license_summary", "outputs"]
}
