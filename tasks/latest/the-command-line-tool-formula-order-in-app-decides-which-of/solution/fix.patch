+// stringSuper implements the plain string-token comparison that decorated
+// tokens fall back to when neither special rule applies.
+func stringSuper(a, b token) int {
+	switch b.k {
+	case kNumeric:
+		return -numericCmp(b, a)
+	case kNull:
+		return -nullCmp(b, a)
+	default:
+		return cmpStr(a.str, b.str)
+	}
+}
+
+func nullCmp(a, b token) int {
+	switch b.k {
+	case kNull:
+		return 0
+	case kNumeric:
+		if b.num == 0 {
+			return 0
+		}
+		return -1
+	case kAlpha, kBeta, kPre, kRC:
+		return 1
+	default:
+		return -1
+	}
+}
+
+func numericCmp(a, b token) int {
+	switch b.k {
+	case kNumeric:
+		return cmpInt(a.num, b.num)
+	case kNull:
+		return -nullCmp(b, a)
+	default:
+		return 1
+	}
+}
