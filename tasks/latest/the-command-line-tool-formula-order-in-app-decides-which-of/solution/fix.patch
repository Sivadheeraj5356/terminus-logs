+var (
+	reAlpha   = regexp.MustCompile(`(?i)\A(?:alpha[0-9]*|a[0-9]+)\z`)
+	reBeta    = regexp.MustCompile(`(?i)\A(?:beta[0-9]*|b[0-9]+)\z`)
+	reRC      = regexp.MustCompile(`(?i)\A(?:rc[0-9]*)\z`)
+	rePre     = regexp.MustCompile(`(?i)\A(?:pre[0-9]*)\z`)
+	rePatch   = regexp.MustCompile(`(?i)\A(?:p[0-9]*)\z`)
+	rePost    = regexp.MustCompile(`(?i)\A(?:.post[0-9]+)\z`)
+	reNumeric = regexp.MustCompile(`(?i)\A(?:[0-9]+)\z`)
+	reString  = regexp.MustCompile(`(?i)\A(?:[a-z]+)\z`)
+	reDigits  = regexp.MustCompile(`[0-9]+`)
+	headRe    = regexp.MustCompile(`\AHEAD(?:-.*)?\z`)
+)
+
+func rev(s string) int {
+	m := reDigits.FindString(s)
+	if m == "" {
+		return 0
+	}
+	n, _ := strconv.Atoi(m)
+	return n
+}
+
+func classify(val string) token {
+	switch {
+	case reAlpha.MatchString(val):
+		return token{k: kAlpha, num: rev(val), str: val}
+	case reBeta.MatchString(val):
+		return token{k: kBeta, num: rev(val), str: val}
+	case reRC.MatchString(val):
+		return token{k: kRC, num: rev(val), str: val}
+	case rePre.MatchString(val):
+		return token{k: kPre, num: rev(val), str: val}
+	case rePatch.MatchString(val):
+		return token{k: kPatch, num: rev(val), str: val}
+	case rePost.MatchString(val):
+		return token{k: kPost, num: rev(val), str: val}
+	case reNumeric.MatchString(val):
+		n, _ := strconv.Atoi(val)
+		return token{k: kNumeric, num: n, str: val}
+	case reString.MatchString(val):
+		return token{k: kString, str: val}
+	default:
+		return token{k: kString, str: val}
+	}
+}
+
+func tokenize(v string) []token {
+	subs := scanRe.FindAllString(v, -1)
+	toks := make([]token, 0, len(subs))
+	for _, s := range subs {
+		toks = append(toks, classify(s))
+	}
+	return toks
+}
+
+func isHead(v string) bool { return headRe.MatchString(v) }
+
+func tokenAt(t []token, i int) token {
+	if i < len(t) {
+		return t[i]
+	}
+	return nullToken
+}
+
+func cmpInt(a, b int) int {
+	switch {
+	case a < b:
+		return -1
+	case a > b:
+		return 1
+	default:
+		return 0
+	}
+}
+
+func cmpStr(a, b string) int {
+	switch {
+	case a < b:
+		return -1
+	case a > b:
+		return 1
+	default:
+		return 0
+	}
+}
+
+func sign(x int) int {
+	switch {
+	case x < 0:
+		return -1
+	case x > 0:
+		return 1
+	default:
+		return 0
+	}
+}
