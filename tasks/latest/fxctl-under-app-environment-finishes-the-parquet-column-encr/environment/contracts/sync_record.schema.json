{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "type": "object",
  "required": ["run_meta", "bind_rows", "record_digest"],
  "properties": {
    "run_meta": {
      "type": "object",
      "required": ["case_id", "phase", "seq"],
      "properties": {
        "case_id": {"type": "string"},
        "phase": {"type": "string", "enum": ["seal", "verify", "append"]},
        "seq": {"type": "integer"}
      }
    },
    "bind_rows": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["grp", "key_idx", "aad_hex", "row_hex"],
        "properties": {
          "grp": {"type": "integer"},
          "key_idx": {"type": "integer"},
          "aad_hex": {"type": "string"},
          "row_hex": {"type": "string", "minLength": 12, "maxLength": 12}
        }
      }
    },
    "cross_aad_digest": {"type": "string"},
    "part_sig": {"type": "string", "minLength": 12, "maxLength": 12},
    "record_digest": {"type": "string", "minLength": 64, "maxLength": 64}
  }
}
