+/* Position slot: 'p' resolves to the remembered match position. */
+static int arg_pos(unsigned char c, int pos_mem) {
+    if (c == 'p') {
+        return pos_mem;
+    }
+    return rule_arg_value(c);
+}
+
+static int is_lower(int c) { return c >= 'a' && c <= 'z'; }
+static int is_upper(int c) { return c >= 'A' && c <= 'Z'; }
+static int is_alpha(int c) { return is_lower(c) || is_upper(c); }
+
+static void toggle_at(char *a, int p) { if (is_alpha((unsigned char)a[p])) a[p] ^= 0x20; }
+static void lower_at(char *a, int p)  { if (is_upper((unsigned char)a[p])) a[p] ^= 0x20; }
+static void upper_at(char *a, int p)  { if (is_lower((unsigned char)a[p])) a[p] ^= 0x20; }
+static void swap_at(char *a, int l, int r) { char t = a[r]; a[r] = a[l]; a[l] = t; }
+
+static int op_reverse(char *a, int n) {
+    for (int l = 0; l < n; l++) {
+        int r = n - 1 - l;
+        if (l >= r) break;
+        swap_at(a, l, r);
+    }
+    return n;
+}
+
+static int op_double(char *a, int n) {
+    if (n * 2 >= BUF) return n;
+    memcpy(a + n, a, (size_t)n);
+    return n * 2;
+}
+
+static int op_double_times(char *a, int n, int times) {
+    if ((n * times) + n >= BUF) return n;
+    int orig = n;
+    for (int i = 0; i < times; i++) {
+        memcpy(a + n, a, (size_t)orig);
+        n += orig;
+    }
+    return n;
+}
+
+static int op_reflect(char *a, int n) {
+    if (n * 2 >= BUF) return n;
+    op_double(a, n);
+    op_reverse(a + n, n);
+    return n * 2;
+}
+
+static int op_rotate_left(char *a, int n) {
+    for (int l = 0, r = n - 1; r > 0; r--) swap_at(a, l, r);
+    return n;
+}
+
+static int op_rotate_right(char *a, int n) {
+    for (int l = 0, r = n - 1; l < r; l++) swap_at(a, l, r);
+    return n;
+}
+
+static int op_append(char *a, int n, char c) {
+    if (n + 1 >= BUF) return n;
+    a[n] = c;
+    return n + 1;
+}
+
+static int op_prepend(char *a, int n, char c) {
+    if (n + 1 >= BUF) return n;
+    for (int i = n - 1; i > -1; i--) a[i + 1] = a[i];
+    a[0] = c;
+    return n + 1;
+}
+
+static int op_delete_at(char *a, int n, int p) {
+    if (p >= n) return n;
+    for (int i = p; i < n - 1; i++) a[i] = a[i + 1];
+    return n - 1;
+}
+
+static int op_extract(char *a, int n, int p, int len) {
+    if (p >= n) return n;
+    if (p + len > n) return n;
+    for (int i = 0; i < len; i++) a[i] = a[p + i];
+    return len;
+}
+
+static int op_omit(char *a, int n, int p, int len) {
+    if (p >= n) return n;
+    if (p + len > n) return n;
+    for (int i = p; i < n - len; i++) a[i] = a[i + len];
+    return n - len;
+}
+
+static int op_insert(char *a, int n, int p, char c) {
+    if (p > n) return n;
+    if (n + 1 >= BUF) return n;
+    for (int i = n - 1; i > p - 1; i--) a[i + 1] = a[i];
+    a[p] = c;
+    return n + 1;
+}
+
+static int op_overstrike(char *a, int n, int p, char c) {
+    if (p >= n) return n;
+    a[p] = c;
+    return n;
+}
+
+static int op_truncate(char *a, int n, int p) {
+    if (p >= n) return n;
+    memset(a + p, 0, (size_t)(n - p));
+    return p;
+}
+
+static int op_replace(char *a, int n, char oldc, char newc) {
+    for (int i = 0; i < n; i++) if (a[i] == oldc) a[i] = newc;
+    return n;
+}
+
+static int op_purge(char *a, int n, char c) {
+    int out = 0;
+    for (int i = 0; i < n; i++) {
+        if (a[i] == c) continue;
+        a[out++] = a[i];
+    }
+    return out;
+}
+
+static int op_dupechar_at(char *a, int n, int p, int len) {
+    if (n == 0) return n;
+    if (n + len >= BUF) return n;
+    char c = a[p];
+    for (int i = 0; i < len; i++) n = op_insert(a, n, p, c);
+    return n;
+}
+
+static int op_dupechar_all(char *a, int n) {
+    if (n == 0) return n;
+    if (n + n >= BUF) return n;
+    for (int i = n - 1; i > -1; i--) {
+        int np = i * 2;
+        a[np] = a[i];
+        a[np + 1] = a[i];
+    }
+    return n * 2;
+}
+
+static int op_dupeblock_prepend(char *a, int n, int len) {
+    if (len > n) return n;
+    if (n + len >= BUF) return n;
+    char cs[64] = {0};
+    memcpy(cs, a, (size_t)len);
+    for (int i = 0; i < len; i++) n = op_insert(a, n, i, cs[i]);
+    return n;
+}
+
+static int op_dupeblock_append(char *a, int n, int len) {
+    if (len > n) return n;
+    if (n + len >= BUF) return n;
+    int p = n - len;
+    for (int i = 0; i < len; i++) n = op_append(a, n, a[p + i]);
+    return n;
+}
+
+static int op_switch_check(char *a, int n, int p, int q) {
+    if (p >= n) return n;
+    if (q >= n) return n;
+    swap_at(a, p, q);
+    return n;
+}
+
+static int op_toggle_sep(char *a, int n, char c, int nth) {
+    int toggle_next = 0, occ = 0;
+    for (int p = 0; p < n; p++) {
+        if (a[p] == c) {
+            if (occ == nth) toggle_next = 1;
+            else occ++;
+            continue;
+        }
+        if (toggle_next) { toggle_at(a, p); break; }
+    }
+    return n;
+}
+
+static int op_title_sep(char *a, int n, char c) {
+    int up_next = 1;
+    for (int p = 0; p < n; p++) {
+        if (a[p] == c) { up_next = 1; continue; }
+        if (up_next) { up_next = 0; upper_at(a, p); }
+        else lower_at(a, p);
+    }
+    if (n) upper_at(a, 0);
+    return n;
+}
+
+static int op_insert_multi(char *a, int n, int ap, char *m, int ml, int mp, int cpy) {
+    if (n + cpy > BUF) return RULE_SKIP_REJECT;
+    if (ap > n) return RULE_SKIP_REJECT;
+    if (mp > ml) return RULE_SKIP_REJECT;
+    if (mp + cpy > ml) return RULE_SKIP_REJECT;
+    if (cpy < 1) return RULE_SKIP_SYNTAX;
+    memmove(m, m + mp, (size_t)(ml - mp));
+    memcpy(m + cpy, a + ap, (size_t)(n - ap));
+    memcpy(a + ap, m, (size_t)(n - ap + cpy));
+    return n + cpy;
+}
