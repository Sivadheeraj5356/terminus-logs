#!/bin/bash
# Boots the glyph-mill runtime daemon before handing control to the
# container's normal command (an interactive shell for the agent).
#
# The daemon's compiled bytecode (/app/glyph-mill/glyph_mill_runtime.pyc)
# is only ever read here, once, to start a background process that keeps
# the game logic resident in its own memory. The on-disk artifact is then
# deleted, so nothing importable/readable containing that logic remains by
# the time any shell (agent or verifier) becomes interactive.
set -e

RUNTIME_PYC=/app/glyph-mill/glyph_mill_runtime.pyc
SOCK=/run/glyph-mill.sock
PID_FILE=/run/glyph-mill.pid

# Idempotent: this entrypoint only needs to run once per container, but
# nothing stops it from being invoked again by hand (e.g. while poking
# around /usr/local/bin). If a daemon from an earlier run is already alive
# and listening, skip straight to exec instead of tearing down its socket -
# by this point the .pyc is gone anyway, so a naive re-run couldn't restart
# it even if it tried.
if [ -S "$SOCK" ] && [ -f "$PID_FILE" ] && kill -0 "$(cat "$PID_FILE" 2>/dev/null)" 2>/dev/null; then
    exec "$@"
fi

rm -f "$SOCK"
nohup python3 "$RUNTIME_PYC" >/var/log/glyph-mill-daemon.log 2>&1 &
disown

for _ in $(seq 1 100); do
    [ -S "$SOCK" ] && break
    sleep 0.1
done

if [ ! -S "$SOCK" ]; then
    echo "glyph-mill daemon failed to start" >&2
    cat /var/log/glyph-mill-daemon.log >&2 || true
    exit 1
fi

rm -f "$RUNTIME_PYC"

exec "$@"
