{
  "output_path": "/app/output/expected.json",
  "witness_binary_path": "/app/bin/keyshare_witness",
  "engine_source_directory": "/app/keyshare_engine",
  "witness_rerun_emits_identical_report": true,
  "witness_never_modifies_input_shards": true,
  "wrong_typed_field_verdict": "REJECTED_TYPE",
  "missing_required_field_verdict": "INVALID",
  "top_level_keys": ["decisions", "by_service", "by_verdict", "summary"],
  "decision_fields": ["observation_id", "service_id", "verdict", "matched_group"],
  "by_service_fields": [
    "service_id",
    "pre_rollout_pass",
    "hybrid_pq_ok",
    "classic_ok",
    "deprecated_grace",
    "seal_rescued",
    "rate_limited",
    "policy_downgrade_blocked",
    "insufficient_strength",
    "duplicate_observation",
    "quota_exhausted",
    "group_banned",
    "rejected_type",
    "invalid",
    "no_groups_offered",
    "total"
  ],
  "summary_keys": ["total_observations", "successful", "rejected", "report_digest"],
  "verdict_set": [
    "HYBRID_PQ_OK",
    "CLASSIC_OK",
    "DEPRECATED_GRACE",
    "PRE_ROLLOUT_PASS",
    "SEAL_RESCUED",
    "RATE_LIMITED",
    "POLICY_DOWNGRADE_BLOCKED",
    "INSUFFICIENT_STRENGTH",
    "DUPLICATE_OBSERVATION",
    "QUOTA_EXHAUSTED",
    "GROUP_BANNED",
    "UNKNOWN_SERVICE",
    "NO_GROUPS_OFFERED",
    "REJECTED_TYPE",
    "INVALID"
  ],
  "verdict_severity_high_to_low": [
    "REJECTED_TYPE",
    "INVALID",
    "NO_GROUPS_OFFERED",
    "UNKNOWN_SERVICE",
    "GROUP_BANNED",
    "QUOTA_EXHAUSTED",
    "DUPLICATE_OBSERVATION",
    "INSUFFICIENT_STRENGTH",
    "POLICY_DOWNGRADE_BLOCKED",
    "RATE_LIMITED",
    "SEAL_RESCUED",
    "DEPRECATED_GRACE",
    "CLASSIC_OK",
    "HYBRID_PQ_OK",
    "PRE_ROLLOUT_PASS"
  ],
  "successful_verdicts": ["HYBRID_PQ_OK", "CLASSIC_OK", "DEPRECATED_GRACE", "PRE_ROLLOUT_PASS", "SEAL_RESCUED"],
  "rejected_verdicts": [
    "POLICY_DOWNGRADE_BLOCKED",
    "GROUP_BANNED",
    "RATE_LIMITED",
    "QUOTA_EXHAUSTED",
    "DUPLICATE_OBSERVATION",
    "INSUFFICIENT_STRENGTH",
    "NO_GROUPS_OFFERED",
    "REJECTED_TYPE",
    "UNKNOWN_SERVICE",
    "INVALID"
  ],
  "decisions_sort_order_keys": ["severity_desc", "service_id_asc", "observed_ts_ns_asc", "observation_id_asc"],
  "by_service_sort_order": "service_id_asc",
  "phase_boundary_left_inclusive_right_exclusive": true,
  "grace_window_after_rollout_end": true,
  "grace_window_is_already_enforced_for_pq_mandatory": true,
  "banned_overrides_phase_and_rate": true,
  "empty_offered_groups_yields_no_groups_offered": true,
  "seal_rescue_requires_valid_chain_and_correct_hmac": true,
  "seal_chain_break_invalidates_that_pin_and_all_later_pins_for_the_same_service": true,
  "seal_rescue_overrides_group_banned_only": true,
  "seal_rescue_bypasses_quota_and_rate_and_phase_and_strength": true,
  "quota_increments_only_for_observations_reaching_phase_or_rate_gate": true,
  "rate_counter_excludes_prior_rejections": true,
  "duplicate_dedup_key_is_observation_id": true,
  "duplicate_first_seen_by_global_sort_wins": true,
  "client_override_replaces_service_policy_tier_when_present": true,
  "alias_resolution_returns_canonical_group_name_in_matched_group": true,
  "insufficient_strength_triggers_when_highest_offered_group_strength_below_service_min_security_bits": true,
  "insufficient_strength_only_applies_from_rollout_start_onward": true,
  "policy_tier_pq_mandatory_no_hybrid_in_or_after_grace": "POLICY_DOWNGRADE_BLOCKED",
  "policy_tier_pq_mandatory_deprecated_only_in_or_after_grace": "POLICY_DOWNGRADE_BLOCKED",
  "policy_tier_hybrid_preferred_deprecated_only_after_grace": "POLICY_DOWNGRADE_BLOCKED",
  "policy_tier_hybrid_preferred_classic_in_or_after_grace": "CLASSIC_OK",
  "policy_tier_classic_only_hybrid_offered_accepted": "HYBRID_PQ_OK",
  "matched_group_set_for_verdicts": ["HYBRID_PQ_OK", "CLASSIC_OK", "DEPRECATED_GRACE", "GROUP_BANNED", "SEAL_RESCUED"],
  "matched_group_first_offered_member_of_winning_class_after_alias_resolution": true,
  "matched_group_unmatched_default": "",
  "group_name_normalization": "lowercase_no_whitespace",
  "type_strict_fields": ["observation_id", "service_id", "observed_ts_ns", "offered_groups", "client_id"],
  "required_fields": ["observation_id", "service_id", "observed_ts_ns", "offered_groups"],
  "observation_shard_paths_relative_to_data_root": [
    "handshake_capture/h_pre_rollout.ndjson",
    "handshake_capture/h_mid_rollout.ndjson",
    "handshake_capture/h_late_rollout.ndjson"
  ],
  "observation_processing_order_keys": ["observed_ts_ns_asc", "observation_id_asc"],
  "digest_preimage_format": "pipe_separated_lines_newline_joined",
  "digest_decision_template": "D|<observation_id>|<service_id>|<verdict>|<matched_group>",
  "digest_service_template": "S|<service_id>|<pre_rollout_pass>|<hybrid_pq_ok>|<classic_ok>|<deprecated_grace>|<seal_rescued>|<rate_limited>|<policy_downgrade_blocked>|<insufficient_strength>|<duplicate_observation>|<quota_exhausted>|<group_banned>|<rejected_type>|<invalid>|<no_groups_offered>|<total>",
  "digest_summary_template": "T|<total_observations>|<successful>|<rejected>",
  "digest_algorithm": "sha256",
  "digest_hex_prefix_length": 16
}
