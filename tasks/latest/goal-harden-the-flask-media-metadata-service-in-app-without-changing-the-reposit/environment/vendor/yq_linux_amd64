#!/usr/bin/env python3
import json
import sys
from pathlib import Path

import yaml

VERSION = "v4.53.3"


def load_yaml(path):
    with open(path, "r", encoding="utf-8") as fh:
        return yaml.safe_load(fh)


def lookup(data, expr):
    expr = expr.strip()
    if expr.startswith("e "):
        expr = expr[2:].strip()
    if expr.startswith("eval "):
        expr = expr[5:].strip()
    if expr.startswith("."):
        expr = expr[1:]
    if not expr:
        return data
    cur = data
    for part in expr.split("."):
        if part == "":
            continue
        if isinstance(cur, dict):
            cur = cur[part]
        elif isinstance(cur, list):
            cur = cur[int(part)]
        else:
            raise KeyError(part)
    return cur


def scalar(value):
    if value is True:
        return "true"
    if value is False:
        return "false"
    if value is None:
        return "null"
    return str(value)


def main(argv):
    if len(argv) >= 2 and argv[1] == "--version":
        print(f"yq version {VERSION}")
        return 0

    output_json = False
    raw = False
    args = []
    i = 1
    while i < len(argv):
        arg = argv[i]
        if arg in {"-r", "--raw-output"}:
            raw = True
        elif arg.startswith("-o="):
            output_json = arg.split("=", 1)[1] == "json"
        elif arg == "-o":
            i += 1
            output_json = i < len(argv) and argv[i] == "json"
        elif arg in {"e", "eval"}:
            pass
        else:
            args.append(arg)
        i += 1

    if len(args) < 2:
        print("usage: yq [-r] [-o=json] <expr> <file>", file=sys.stderr)
        return 2

    expr, filename = args[-2], args[-1]
    value = lookup(load_yaml(Path(filename)), expr)
    if output_json:
        print(json.dumps(value, separators=(",", ":")))
    elif raw:
        if isinstance(value, (dict, list)):
            print(json.dumps(value, separators=(",", ":")))
        else:
            print(scalar(value))
    else:
        print(yaml.safe_dump(value, default_flow_style=False).rstrip())
    return 0


if __name__ == "__main__":
    raise SystemExit(main(sys.argv))
