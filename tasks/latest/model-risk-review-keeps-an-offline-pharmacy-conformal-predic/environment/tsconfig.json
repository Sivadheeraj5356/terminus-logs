{
  "compilerOptions": {
    "target": "ES2022",
    "module": "Node16",
    "moduleResolution": "Node16",
    "outDir": "dist",
    "rootDir": ".",
    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "declaration": false,
    "resolveJsonModule": true
  },
  "include": [
    "src/**/*.ts",
    "k4/**/*.ts",
    "n8/**/*.ts"
  ],
  "exclude": [
    "node_modules",
    "dist"
  ]
}
