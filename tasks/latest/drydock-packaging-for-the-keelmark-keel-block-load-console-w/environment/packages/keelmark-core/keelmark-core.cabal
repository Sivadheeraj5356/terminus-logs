cabal-version:      2.4
name:               keelmark-core
version:            1.3.9
synopsis:           Keelmark core telemetry parsing and calibration
license:            MIT
build-type:         Simple

library
  hs-source-dirs:   compat src
  exposed-modules:  Keelmark.Types
                    Keelmark.Scan
  build-depends:    base >= 4.14 && < 5
                  , aeson >= 2.1 && < 2.3
                  , bytestring
                  , text
                  , keelmark-report
  default-language: Haskell2010
