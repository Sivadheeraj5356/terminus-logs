 use std::fs::{self, OpenOptions};
 use std::io::{self, Write};
 use std::os::unix::fs::PermissionsExt;
-use std::path::Path;
+use std::path::{Path, PathBuf};
+use std::process;
+use std::sync::atomic::{AtomicU64, Ordering};
+
+static COUNTER: AtomicU64 = AtomicU64::new(0);
 
 pub fn publish(path: &Path, bytes: &[u8]) -> io::Result<()> {
-    if let Some(parent) = path.parent() {
-        fs::create_dir_all(parent)?;
+    let parent = path.parent().ok_or_else(|| io::Error::new(io::ErrorKind::InvalidInput, "no parent"))?;
+    let created = create_missing_parents(parent)?;
+    let result = publish_inner(path, parent, bytes);
+    if result.is_err() {
+        cleanup_parents(&created);
+    }
+    result
+}
+
+fn publish_inner(path: &Path, parent: &Path, bytes: &[u8]) -> io::Result<()> {
+    let (temp_path, mut file) = create_temp(parent)?;
+    let result = (|| {
+        file.write_all(bytes)?;
+        file.sync_all()?;
+        file.set_permissions(fs::Permissions::from_mode(0o644))?;
+        drop(file);
+        fs::rename(&temp_path, path)?;
+        if let Ok(directory) = OpenOptions::new().read(true).open(parent) {
+            let _ = directory.sync_all();
+        }
+        Ok(())
+    })();
+    if result.is_err() {
+        let _ = fs::remove_file(&temp_path);
+    }
+    result
+}
+
+fn create_temp(parent: &Path) -> io::Result<(PathBuf, fs::File)> {
+    for _ in 0..100 {
+        let serial = COUNTER.fetch_add(1, Ordering::Relaxed);
+        let name = format!(".forest-audit.{}.{}.tmp", process::id(), serial);
+        let path = parent.join(name);
+        match OpenOptions::new().write(true).create_new(true).open(&path) {
+            Ok(file) => return Ok((path, file)),
+            Err(error) if error.kind() == io::ErrorKind::AlreadyExists => continue,
+            Err(error) => return Err(error),
+        }
+    }
+    Err(io::Error::new(io::ErrorKind::AlreadyExists, "temporary-name exhaustion"))
+}
+
+fn create_missing_parents(parent: &Path) -> io::Result<Vec<PathBuf>> {
+    let mut missing = Vec::new();
+    let mut cursor = parent;
+    while !cursor.exists() {
+        missing.push(cursor.to_path_buf());
+        cursor = cursor.parent().ok_or_else(|| io::Error::new(io::ErrorKind::InvalidInput, "invalid parent"))?;
+    }
+    for directory in missing.iter().rev() {
+        fs::create_dir(directory)?;
+    }
+    Ok(missing)
+}
+
+fn cleanup_parents(created: &[PathBuf]) {
+    for directory in created {
+        let _ = fs::remove_dir(directory);
