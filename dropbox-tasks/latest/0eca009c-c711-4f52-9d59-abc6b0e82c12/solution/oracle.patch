+fn walk_tree(
+    tree: &str,
+    node_id: &str,
+    nodes: &BTreeMap<(String, String), Node>,
+    visiting: &mut BTreeSet<String>,
+    visited: &mut BTreeSet<String>,
+) -> bool {
+    if visited.contains(node_id) {
+        return true;
+    }
+    if !visiting.insert(node_id.to_string()) {
+        return false;
+    }
+    let Some(node) = nodes.get(&(tree.to_string(), node_id.to_string())) else {
+        return false;
+    };
+    for link in [&node.left, &node.right] {
+        if let Child::Node(next) = link {
+            if !walk_tree(tree, next, nodes, visiting, visited) {
+                return false;
+            }
+        }
+    }
+    visiting.remove(node_id);
+    visited.insert(node_id.to_string());
+    true
+}
