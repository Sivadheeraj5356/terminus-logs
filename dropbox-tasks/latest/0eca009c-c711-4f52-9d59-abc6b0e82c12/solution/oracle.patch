+fn find_counterexample(model: &Model, state: &CheckState, base_prediction: &str) -> Option<Counterexample> {
+    let features: Vec<_> = model.features.values().collect();
+    let mut current = BTreeMap::<String, i32>::new();
+    let mut best: Option<Counterexample> = None;
+    enumerate(
+        model,
+        state,
+        base_prediction,
+        &features,
+        0,
+        0,
+        0,
+        &mut current,
+        &mut best,
+    );
+    best
+}
+
+#[allow(clippy::too_many_arguments)]
+fn enumerate(
+    model: &Model,
+    state: &CheckState,
+    base_prediction: &str,
+    features: &[&crate::types::Feature],
+    index: usize,
+    cost: i32,
+    changed: usize,
+    current: &mut BTreeMap<String, i32>,
+    best: &mut Option<Counterexample>,
+) {
+    if cost > state.budget {
+        return;
+    }
+    if let Some(existing) = best {
+        if cost > existing.cost {
+            return;
+        }
+    }
+    if index == features.len() {
+        let evaluation = evaluate(model, current);
+        if evaluation.prediction == base_prediction {
+            return;
+        }
+        let candidate = Counterexample {
+            cost,
+            changed,
+            values: current.clone(),
+            evaluation,
+        };
+        if best.as_ref().is_none_or(|old| better(&candidate, old, features)) {
+            *best = Some(candidate);
+        }
+        return;
+    }
+
+    let feature = features[index];
+    let base_value = state.point[&feature.id];
+    if state.locked.contains(&feature.id) {
+        current.insert(feature.id.clone(), base_value);
+        enumerate(model, state, base_prediction, features, index + 1, cost, changed, current, best);
+        current.remove(&feature.id);
+        return;
+    }
+
+    for value in feature.min..=feature.max {
+        let delta = (value - base_value).abs();
+        let next_cost = cost + feature.cost * delta;
+        current.insert(feature.id.clone(), value);
+        enumerate(
+            model,
+            state,
+            base_prediction,
+            features,
+            index + 1,
+            next_cost,
+            changed + usize::from(value != base_value),
+            current,
+            best,
+        );
+    }
+    current.remove(&feature.id);
+}
+
+fn better(
+    candidate: &Counterexample,
+    old: &Counterexample,
+    features: &[&crate::types::Feature],
+) -> bool {
+    if candidate.cost != old.cost {
+        return candidate.cost < old.cost;
+    }
+    if candidate.changed != old.changed {
+        return candidate.changed < old.changed;
+    }
+    for feature in features {
+        let a = candidate.values[&feature.id];
+        let b = old.values[&feature.id];
+        if a != b {
+            return a < b;
+        }
+    }
+    false
+}
