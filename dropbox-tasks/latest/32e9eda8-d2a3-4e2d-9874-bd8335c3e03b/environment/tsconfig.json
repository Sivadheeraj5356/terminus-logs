{
  "compilerOptions": {
    "target": "ES2022",
    "module": "commonjs",
    "lib": [
      "ES2022"
    ],
    "outDir": "dist",
    "rootDir": ".",
    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true,
    "resolveJsonModule": true
  },
  "include": [
    "h2k/**/*.ts",
    "n6p/**/*.ts",
    "w3q/**/*.ts",
    "r7t/**/*.ts",
    "tools/**/*.ts",
    "pilot/**/*.ts",
    "engine/**/*.ts",
    "lanes/**/*.ts"
  ]
}
