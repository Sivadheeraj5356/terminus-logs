+
+    private static final class Best {
+        double total = Double.NEGATIVE_INFINITY;
+        double left = 0.0;
+        List<Cand> chosen = List.of();
+
+        void consider(double totalPress, List<Cand> chosen, double left) {
+            if (totalPress > total + 1e-12) {
+                accept(totalPress, chosen, left);
+                return;
+            }
+            if (Math.abs(totalPress - total) <= 1e-12) {
+                if (lexLess(chosen, this.chosen)) {
+                    accept(totalPress, chosen, left);
+                }
+            }
+        }
+
+        private void accept(double totalPress, List<Cand> chosen, double left) {
+            this.total = totalPress;
+            this.left = left;
+            this.chosen = new ArrayList<>(chosen);
+        }
+
+        private static boolean lexLess(List<Cand> a, List<Cand> b) {
+            int n = Math.min(a.size(), b.size());
+            for (int i = 0; i < n; i++) {
+                Cand x = a.get(i);
+                Cand y = b.get(i);
+                if (x.idx != y.idx) {
+                    return x.idx < y.idx;
+                }
+                int c = x.src.compareTo(y.src);
+                if (c != 0) {
+                    return c < 0;
+                }
+            }
+            return a.size() < b.size();
+        }
     }
