+    private static PathEval evalPath(
+            Map<String, Object> graph,
+            String src,
+            double amp,
+            LimView lims,
+            SoftView softs) {
+        if (amp > lims.maxAmp) {
+            return null;
+        }
+        List<String> path = shortestPath(graph, src);
+        if (path == null || path.isEmpty()) {
+            return null;
+        }
+        double residual = amp;
+        for (int i = 0; i < path.size(); i++) {
+            String id = path.get(i);
+            Map<String, Object> node = asNode(graph.get(id));
+            if (node == null) {
+                return null;
+            }
+            String t = String.valueOf(node.get("t"));
+            if ("M".equals(t)) {
+                double k = node.containsKey("k") ? asDouble(node.get("k")) : 0.0;
+                double factor = softs.softFloor * Math.max(0.05, 1.0 - k);
+                residual *= factor;
+            }
+        }
+        double leak = softs.egressCap - residual;
+        if (!(leak > 0.0)) {
+            return null;
+        }
+        return new PathEval(residual, leak);
+    }
