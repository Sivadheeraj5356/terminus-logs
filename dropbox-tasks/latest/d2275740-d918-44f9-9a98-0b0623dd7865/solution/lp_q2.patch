+    @SuppressWarnings("unchecked")
+    private static List<String> shortestPath(Map<String, Object> graph, String src) {
+        if (!graph.containsKey(src)) {
+            return null;
+        }
+        Map<String, String> prev = new HashMap<>();
+        Map<String, Integer> dist = new HashMap<>();
+        java.util.ArrayDeque<String> q = new java.util.ArrayDeque<>();
+        dist.put(src, 0);
+        q.add(src);
+        String bestX = null;
+        int bestDist = Integer.MAX_VALUE;
+        while (!q.isEmpty()) {
+            String cur = q.removeFirst();
+            int d = dist.getOrDefault(cur, Integer.MAX_VALUE);
+            Map<String, Object> node = asNode(graph.get(cur));
+            if (node == null) {
+                continue;
+            }
+            if ("X".equals(String.valueOf(node.get("t")))) {
+                if (d < bestDist) {
+                    bestDist = d;
+                    bestX = cur;
+                }
+                continue;
+            }
+            if (d >= bestDist) {
+                continue;
+            }
+            List<String> nbrs = new ArrayList<>();
+            Object e = node.get("e");
+            if (e instanceof List<?>) {
+                for (Object x : (List<Object>) e) {
+                    nbrs.add(String.valueOf(x));
+                }
+            }
+            // undirected reverse edges; preserve graph-key presentation order
+            for (Map.Entry<String, Object> en : graph.entrySet()) {
+                Map<String, Object> other = asNode(en.getValue());
+                if (other == null) {
+                    continue;
+                }
+                Object oe = other.get("e");
+                if (oe instanceof List<?>) {
+                    for (Object x : (List<Object>) oe) {
+                        if (cur.equals(String.valueOf(x)) && !nbrs.contains(en.getKey())) {
+                            nbrs.add(en.getKey());
+                        }
+                    }
+                }
+            }
+            for (String nb : nbrs) {
+                if (dist.containsKey(nb)) {
+                    continue;
+                }
+                dist.put(nb, d + 1);
+                prev.put(nb, cur);
+                q.add(nb);
+            }
+        }
+        if (bestX == null) {
+            return null;
+        }
+        List<String> path = new ArrayList<>();
+        String cur = bestX;
+        path.add(cur);
+        while (!cur.equals(src)) {
+            cur = prev.get(cur);
+            if (cur == null) {
+                return null;
+            }
+            path.add(cur);
+        }
+        Collections.reverse(path);
+        return path;
+    }
