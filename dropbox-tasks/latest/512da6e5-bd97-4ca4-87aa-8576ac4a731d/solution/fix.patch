+func parseSource(token string) source {
+	var s source
+	var rest string
+	if strings.Contains(token, "://") {
+		parts := strings.SplitN(token, "://", 2)
+		s.schemePart = strings.ToLower(parts[0])
+		s.hasScheme = true
+		rest = parts[1]
+	} else if strings.HasSuffix(token, ":") && !strings.Contains(token, "/") {
+		s.schemePart = strings.ToLower(token[:len(token)-1])
+		s.hasScheme = true
+		return s
