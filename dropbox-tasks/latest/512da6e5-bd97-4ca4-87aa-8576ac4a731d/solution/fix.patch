+// cgiUnescape percent-decodes a path component: '+' becomes a space, then
+// valid percent-escapes are byte-decoded; malformed escapes are left intact.
+func cgiUnescape(s string) string {
+	s = strings.ReplaceAll(s, "+", " ")
+	var b strings.Builder
+	for i := 0; i < len(s); i++ {
+		if s[i] == '%' && i+2 <= len(s)-1 {
+			h1 := unhex(s[i+1])
+			h2 := unhex(s[i+2])
+			if h1 >= 0 && h2 >= 0 {
+				b.WriteByte(byte(h1<<4 | h2))
+				i += 2
+				continue
+			}
+		}
+		b.WriteByte(s[i])
+	}
+	return b.String()
+}
+
+func unhex(c byte) int {
+	switch {
+	case c >= '0' && c <= '9':
+		return int(c - '0')
+	case c >= 'a' && c <= 'f':
+		return int(c-'a') + 10
+	case c >= 'A' && c <= 'F':
+		return int(c-'A') + 10
+	}
+	return -1
+}
