+// splitURL returns scheme, host, port (with portKnown), and path for a
+// candidate resource URL, mirroring the reference URI decomposition.
+func splitURL(raw string) (scheme, host string, port int, portKnown bool, path string) {
+	sch, rest, ok := splitScheme(raw)
+	if !ok {
+		return "", "", 0, false, ""
+	}
+	scheme = strings.ToLower(sch)
+	if strings.HasPrefix(rest, "//") {
+		auth := rest[2:]
+		var authority, tail string
+		if idx := strings.IndexAny(auth, "/?#"); idx >= 0 {
+			authority = auth[:idx]
+			tail = auth[idx:]
+		} else {
+			authority = auth
+		}
+		if at := strings.LastIndexByte(authority, '@'); at >= 0 {
+			authority = authority[at+1:]
+		}
+		h, p, hasP := splitHostPort(authority)
+		host = strings.ToLower(h)
+		path = tail
+		if q := strings.IndexAny(path, "?#"); q >= 0 {
+			path = path[:q]
+		}
+		if hasP {
+			port = p
+			portKnown = true
+		} else if dp, ok2 := defaultPort(scheme); ok2 {
+			port = dp
+			portKnown = true
+		}
+		return scheme, host, port, portKnown, path
+	}
+	return scheme, "", 0, false, ""
+}
