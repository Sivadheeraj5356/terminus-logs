! apexora-pre-wave3-boundary snapshot — do not overwrite after migration edits
! dist-emea-fra-main-01 — Cisco IOS-XE distribution switch
! migration_state: legacy
version 17.9
hostname dist-emea-fra-main-01
!
ip routing
ip vrf CORP-IT
 rd 65000:1003
 route-target export 65000:1003
 route-target import 65000:1003
!
ip vrf FINANCE
 rd 65000:1103
 route-target export 65000:1103
 route-target import 65000:1103
!
interface Vlan2131
 description Finance gateway SVI
 ip vrf forwarding FINANCE
 ip address 10.213.1.1 255.255.255.0
 standby 10 ip 10.213.1.1
 standby 10 priority 110
 ip access-group ACL-INSIDE-ANY in
!
interface TenGigabitEthernet1/1/1
 description Uplink to core
 switchport trunk allowed vlan 2001-2180
 switchport mode trunk
!
interface TenGigabitEthernet1/1/2
 description Downlink to access
 switchport trunk allowed vlan all
 switchport mode trunk
!
router ospf 1 vrf FINANCE
 network 10.213.0.0 0.0.255.255 area 0
!
