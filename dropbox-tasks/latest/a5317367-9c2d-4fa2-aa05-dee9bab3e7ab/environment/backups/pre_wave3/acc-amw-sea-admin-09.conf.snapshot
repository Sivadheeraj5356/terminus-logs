! apexora-pre-wave3-boundary snapshot — do not overwrite after migration edits
! acc-amw-sea-admin-09 — Cisco IOS-XE access switch
! Apexora SegmentFirst Wave 3
! migration_state: legacy
version 17.9
hostname acc-amw-sea-admin-09
!
no service pad
service timestamps debug datetime msec localtime show-timezone
service timestamps log datetime msec localtime show-timezone
!
spanning-tree mode rapid-pvst
spanning-tree extend system-id
!
vlan internal allocation policy ascending
vlan 2020
 name SEG-020
vlan 121
 name LEGACY-FLAT-020
!
interface GigabitEthernet1/0/1
 description User access port — building admin
 switchport mode access
 switchport access vlan 121
 spanning-tree portfast
 spanning-tree bpduguard enable
 ip access-group ACL-INSIDE-ANY in
!
interface GigabitEthernet1/0/2
 description User access port
 switchport mode access
 switchport access vlan 121
 spanning-tree portfast
!
interface TenGigabitEthernet1/1/1
 description Uplink to distribution
 switchport trunk allowed vlan all
 switchport trunk native vlan 999
 switchport mode trunk
!
interface Vlan121
 description LEGACY-SVI-ON-ACCESS — remove during segmentation
 ip address 10.201.9.1 255.255.255.0
 no ip redirects
!
ip default-gateway 10.201.0.1
!
line con 0
 logging synchronous
line vty 0 4
 transport input ssh
!
