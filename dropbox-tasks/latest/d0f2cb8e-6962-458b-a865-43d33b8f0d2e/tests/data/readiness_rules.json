{
  "serving_frameworks_allowed": [
    "tensorflow-serving",
    "triton",
    "torchserve"
  ],
  "profile_aliases": {
    "production": "production_lane",
    "staging": "staging_lane",
    "canary": "staging",
    "qa": "canary",
    "analytics": "qa",
    "fleet": "analytics"
  },
  "profiles": {
    "production_lane": {
      "min_score": 0.763
    },
    "staging_lane": {
      "min_score": 0.55
    }
  },
  "verdict_lexicon": {
    "ready": "cleared_for_serve",
    "not_ready": "hold_back",
    "deferred": "queue_hold"
  },
  "lexicon_scope": {
    "applies_to": ["mlflow_tags", "artifacts"],
    "excludes": ["drain_report"]
  },
  "rules_sets": {
    "default": {
      "binding_overrides": {}
    },
    "mem_lane": {
      "extends": "default",
      "binding_overrides": {
        "memory_request_norm": {
          "divisor": 5120
        }
      }
    },
    "mem_tight": {
      "extends": "default",
      "binding_overrides": {
        "memory_request_norm": {
          "divisor": 4800
        }
      }
    },
    "gpu_edge": {
      "extends": "default",
      "binding_overrides": {
        "memory_request_norm": {
          "divisor": 6144
        }
      }
    },
    "cpu_turbo": {
      "extends": "default",
      "binding_overrides": {
        "cpu_request_norm": {
          "divisor": 2500
        }
      }
    },
    "edge_strict": {
      "extends": "gpu_edge",
      "binding_overrides": {
        "replicas_meets_min": {
          "minimum": 3
        }
      }
    },
    "roll_ceil": {
      "extends": "default",
      "binding_overrides": {
        "replicas_meets_min": {
          "rolling_unavailable_parse": {
            "percent_suffix": "%",
            "percent_mode": "ceil_of_replicas"
          }
        }
      }
    }
  }
}
