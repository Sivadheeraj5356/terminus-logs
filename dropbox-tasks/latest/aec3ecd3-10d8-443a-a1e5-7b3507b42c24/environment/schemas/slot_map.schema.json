{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "required": ["pack_id", "dim", "nz_live", "nz_cap", "view_digest"],
  "properties": {
    "pack_id": { "type": "string" },
    "dim": { "type": "integer", "minimum": 1 },
    "nz_live": { "type": "integer", "minimum": 0 },
    "nz_cap": { "type": "integer", "minimum": 1 },
    "view_digest": { "type": "string", "minLength": 64, "maxLength": 64 }
  },
  "additionalProperties": false
}
