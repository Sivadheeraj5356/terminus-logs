+      MOD = 2**32
       MAX_STEP = 2_147_483_647
 
       module_function
 
       def parse(value)
-        Integer(value)
+        Integer(value) % MOD
       end
 
+      def serial_gt?(left, right)
+        a = parse(left)
+        b = parse(right)
+        return false if a == b
+
+        ((a - b) % MOD).between?(1, MAX_STEP)
+      end
