+      def matches?(ex, f, eff)
+        return false unless Dns::Name.equal?(ex.zone, f.zone)
+        return false unless Dns::Name.matches_suffix?(f.owner, ex.owner_suffix)
+
+        type_ok = ex.record_type == "*" || ex.record_type == f.record_type
+        return false unless type_ok
