diff -ruN a/lib/zone_publisher/dns/txt.rb b/lib/zone_publisher/dns/txt.rb
--- a/lib/zone_publisher/dns/txt.rb	2026-07-08 20:17:02
+++ b/lib/zone_publisher/dns/txt.rb	2026-07-08 20:16:13
@@ -6,7 +6,43 @@
       module_function
 
       def canonicalize(rdata)
-        rdata.to_s.gsub('"', "").gsub(/\s+/, " ").strip
+        s = rdata.to_s
+        out = +""
+        i = 0
+        pending_space = false
+        started = false
+        while i < s.length
+          ch = s[i]
+          if ch == '"'
+            out << " " if pending_space && started
+            pending_space = false
+            out << '"'
+            i += 1
+            while i < s.length
+              c2 = s[i]
+              if c2 == "\\" && i + 1 < s.length
+                out << c2
+                out << s[i + 1]
+                i += 2
+                next
+              end
+              out << c2
+              i += 1
+              break if c2 == '"'
+            end
+            started = true
+          elsif ch =~ /[[:space:]]/
+            pending_space = true
+            i += 1
+          else
+            out << " " if pending_space && started
+            pending_space = false
+            out << ch
+            started = true
+            i += 1
+          end
+        end
+        out
       end
 
       def canonical?(rdata)
