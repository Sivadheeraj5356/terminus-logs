{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "required": ["direction_order", "format", "goal_room", "level_id", "rooms", "source", "start_room", "walkthrough"],
  "properties": {
    "direction_order": {
      "type": "array",
      "items": {"enum": ["north", "east", "south", "west"]},
      "minItems": 4,
      "maxItems": 4,
      "uniqueItems": true
    },
    "format": {"const": "mlflow-maze-manifest-v1"},
    "goal_room": {"$ref": "#/$defs/id"},
    "level_id": {"$ref": "#/$defs/id"},
    "rooms": {
      "type": "array",
      "items": {"$ref": "#/$defs/room"}
    },
    "source": {
      "type": "object",
      "additionalProperties": false,
      "required": ["experiment_id", "maze_yaml_sha256", "puzzles_toml_sha256", "selected_runs", "tracking_store_sha256"],
      "properties": {
        "experiment_id": {"type": "integer"},
        "maze_yaml_sha256": {"$ref": "#/$defs/sha"},
        "puzzles_toml_sha256": {"$ref": "#/$defs/sha"},
        "selected_runs": {
          "type": "array",
          "items": {"$ref": "#/$defs/run"}
        },
        "tracking_store_sha256": {"$ref": "#/$defs/sha"}
      }
    },
    "start_room": {"$ref": "#/$defs/id"},
    "walkthrough": {
      "type": "object",
      "additionalProperties": false,
      "required": ["moves", "rooms", "sha256", "transcript"],
      "properties": {
        "moves": {"type": "array", "items": {"enum": ["north", "east", "south", "west"]}},
        "rooms": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/id"}},
        "sha256": {"$ref": "#/$defs/sha"},
        "transcript": {"type": "array", "minItems": 2, "items": {"type": "string"}}
      }
    }
  },
  "$defs": {
    "id": {"type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,63}$"},
    "sha": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "exit": {
      "type": "object",
      "additionalProperties": false,
      "required": ["direction", "to"],
      "properties": {
        "direction": {"enum": ["north", "east", "south", "west"]},
        "to": {"$ref": "#/$defs/id"}
      }
    },
    "prompt": {
      "type": "object",
      "additionalProperties": false,
      "required": ["answer_sha256", "id", "prompt", "revision", "run_id"],
      "properties": {
        "answer_sha256": {"$ref": "#/$defs/sha"},
        "id": {"$ref": "#/$defs/id"},
        "prompt": {"type": "string", "minLength": 1},
        "revision": {"type": "integer", "minimum": 0},
        "run_id": {"type": ["string", "null"]}
      }
    },
    "room": {
      "type": "object",
      "additionalProperties": false,
      "required": ["exits", "id", "prompt", "revision", "run_id", "title"],
      "properties": {
        "exits": {"type": "array", "items": {"$ref": "#/$defs/exit"}},
        "id": {"$ref": "#/$defs/id"},
        "prompt": {"oneOf": [{"type": "null"}, {"$ref": "#/$defs/prompt"}]},
        "revision": {"type": "integer", "minimum": 0},
        "run_id": {"type": ["string", "null"]},
        "title": {"type": "string", "minLength": 1}
      }
    },
    "run": {
      "type": "object",
      "additionalProperties": false,
      "required": ["kind", "patch_sha256", "revision", "run_id", "target"],
      "properties": {
        "kind": {"enum": ["puzzle", "room"]},
        "patch_sha256": {"$ref": "#/$defs/sha"},
        "revision": {"type": "integer", "minimum": 1},
        "run_id": {"type": "string", "minLength": 1},
        "target": {"$ref": "#/$defs/id"}
      }
    }
  }
}
