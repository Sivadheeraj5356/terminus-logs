FROM public.ecr.aws/docker/library/golang:1.24-bookworm@sha256:1a6d4452c65dea36aac2e2d606b01b4a029ec90cc1ae53890540ce6173ea77ac AS builder

WORKDIR /src
COPY go.mod ./
COPY cmd ./cmd
COPY coord ./coord
COPY orchestrate ./orchestrate
COPY role ./role
COPY l2pub ./l2pub
COPY state ./state
COPY route ./route
COPY vivostat ./vivostat
COPY simdrive ./simdrive
COPY observemit ./observemit
COPY util ./util
COPY pkg ./pkg
RUN CGO_ENABLED=0 go build -o /vivostep ./cmd/vivostep

FROM debian:bookworm-slim@sha256:4724b8cc51e33e398f0e2e15e18d5ec2851ff0c2280647e1310bc1642182655d

ENV DEBIAN_FRONTEND=noninteractive
ENV TERM=xterm
ENV LANG=C.UTF-8
ENV LC_ALL=C.UTF-8
ENV TMUX_TMPDIR=/var/tmp/tmux
ENV PATH=/usr/local/go/bin:/usr/local/sbin:/usr/local/bin:/usr/sbin:/usr/bin:/sbin:/bin

WORKDIR /app

RUN apt-get update && apt-get install -y --no-install-recommends make=4.3-4.1 patch=2.7.6-7 \
    asciinema=2.2.0-1 \
    ca-certificates=20230311+deb12u1 \
    ncurses-term=6.4-4 \
    python3=3.11.2-1+b1 \
    python3-venv=3.11.2-1+b1 \
    tmux=3.3a-3 \
    && mkdir -p /var/tmp/tmux \
    && chmod 1777 /var/tmp/tmux \
    && rm -rf /var/lib/apt/lists/*

RUN python3 -m venv /opt/verifier-venv \
    && /opt/verifier-venv/bin/pip install --no-cache-dir \
        pytest==8.4.1 \
        pytest-json-ctrf==0.3.5

COPY runtime/tmux.conf /etc/tmux.conf
COPY --from=builder /usr/local/go /usr/local/go
COPY --from=builder /vivostep /usr/local/bin/vivostep
COPY . /app/environment
RUN mkdir -p /app/output /app/data
