cabal-version:      2.4
name:               keelmark
version:            1.4.2
synopsis:           Keelmark drydock keel-block load packaging console
license:            MIT
build-type:         Custom

executable keelmark
  main-is:          Main.hs
  hs-source-dirs:   app
  build-depends:    base >= 4.14 && < 5
                  , keelmark-core
                  , keelmark-report
                  , aeson
                  , bytestring
                  , text
                  , containers
                  , directory
                  , filepath
  default-language: Haskell2010
