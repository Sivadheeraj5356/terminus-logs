+// dfs looks for a fully consistent assignment (no conflicts). It returns the
+// first complete assignment found under highest-version-first ordering, i.e. the
+// max-version consistent install set, or nullopt when no conflict-free assignment
+// exists.
+static std::optional<Outcome> dfs(StrMap assignment, const std::set<std::string> &conflicted,
+                                  const StrMap &requirements, const Registry &reg, int &budget) {
+    budget--;
+    if (budget < 0)
+        throw std::runtime_error("resolution budget exhausted");
+    std::vector<std::string> req = requiredSet(assignment, conflicted, requirements, reg);
+    std::string frontier;
+    std::vector<std::vector<Prim>> frRanges;
+    bool found = false;
+    for (const auto &p : req) {
+        std::vector<std::vector<Prim>> ranges = rangesOf(active(p, assignment, requirements, reg));
+        auto it = assignment.find(p);
+        if (it != assignment.end() && validAssigned(p, it->second, ranges, reg))
+            continue;
+        frontier = p;
+        frRanges = ranges;
+        found = true;
+        break;
+    }
+    if (!found)
+        return Outcome{assignment, conflicted};
+    std::vector<std::string> cs = candidates(frontier, frRanges, reg);
+    StrMap base = assignment;
+    base.erase(frontier);
+    for (const auto &cv : cs) {
+        StrMap na = base;
+        na[frontier] = cv;
+        auto res = dfs(na, conflicted, requirements, reg, budget);
+        if (res)
