+static std::pair<std::string, bool> selectVersion(const std::string &pkg,
+                                                   const std::vector<std::vector<Prim>> &ranges,
+                                                   const Registry &reg) {
+    Ver best;
+    std::string bestVer;
+    bool have = false;
+    auto it = reg.find(pkg);
