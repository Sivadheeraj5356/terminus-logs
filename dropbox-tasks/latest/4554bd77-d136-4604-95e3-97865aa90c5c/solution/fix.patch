+// fill parses 1-3 numeric components with an optional pre-release suffix and
+// reports how many components were written explicitly (the arity).
+static std::pair<Ver, int> fill(std::string raw) {
+    Ver v;
+    size_t dash = raw.find('-');
+    if (dash != std::string::npos) {
+        v.hasPre = true;
+        v.pre = splitStr(raw.substr(dash + 1), '.');
+        raw = raw.substr(0, dash);
+    }
+    std::vector<std::string> parts = splitStr(raw, '.');
+    std::vector<int> nums;
+    for (const auto &p : parts)
+        nums.push_back(toInt(p));
+    int arity = (int)nums.size();
+    while (nums.size() < 3)
+        nums.push_back(0);
+    v.maj = nums[0];
+    v.min = nums[1];
+    v.pat = nums[2];
+    return {v, arity};
+}
