+// reachableClosure returns the set of packages that must actually be installed:
+// starting from the top-level requirements and following the deps declared by
+// each chosen version transitively. A conflicted dependency is not installed and
+// does not activate its own deps, so it stops the traversal. Packages assigned by
+// an abandoned search branch are never reached and are therefore dropped.
+static std::set<std::string> reachableClosure(const StrMap &assignment, const StrMap &requirements,
+                                              const Registry &reg,
+                                              const std::set<std::string> &conflicted) {
+    std::set<std::string> reachable;
+    std::vector<std::string> stack;
+    for (const auto &k : requirements)
+        stack.push_back(k.first);
+    while (!stack.empty()) {
+        std::string p = stack.back();
+        stack.pop_back();
+        if (reachable.count(p) || conflicted.count(p))
+            continue;
+        auto it = assignment.find(p);
+        if (it == assignment.end())
+            continue;
+        reachable.insert(p);
+        for (const auto &dp : depsOf(p, it->second, reg))
+            if (!reachable.count(dp.first))
+                stack.push_back(dp.first);
+    }
+    return reachable;
+}
