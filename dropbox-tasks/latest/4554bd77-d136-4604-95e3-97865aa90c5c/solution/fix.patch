+static std::vector<std::string> conflictPair(const std::string &dep,
+                                             const std::set<std::string> &reachable,
+                                             const StrMap &assignment, const Registry &reg) {
+    std::map<std::string, std::vector<std::vector<Prim>>> bySrc;
+    std::vector<std::string> srcs;
+    // assignment is a std::map, so iteration is already sorted by package name.
+    for (const auto &q : assignment) {
+        if (!reachable.count(q.first))
+            continue;
+        auto deps = depsOf(q.first, q.second, reg);
+        auto dit = deps.find(dep);
+        if (dit != deps.end()) {
+            if (!bySrc.count(q.first))
+                srcs.push_back(q.first);
+            bySrc[q.first].push_back(parseConstraint(dit->second));
+        }
+    }
+    std::sort(srcs.begin(), srcs.end());
+    // A lone requiring package whose own constraint admits no version is itself the
+    // jointly-unsatisfiable set: the conflict names just that one package.
+    if (srcs.size() == 1) {
+        if (!selectVersion(dep, bySrc[srcs[0]], reg).second)
+            return {srcs[0]};
+        return {};
+    }
+    for (size_t i = 0; i < srcs.size(); i++)
+        for (size_t j = i + 1; j < srcs.size(); j++) {
+            std::vector<std::vector<Prim>> combined = bySrc[srcs[i]];
+            for (const auto &r : bySrc[srcs[j]])
