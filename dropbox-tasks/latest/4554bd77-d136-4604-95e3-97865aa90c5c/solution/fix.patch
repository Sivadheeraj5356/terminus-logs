+    // be satisfied: its packages list names the requiring packages whose declared
+    // constraints cannot be jointly satisfied (one when a lone requirer's own
+    // constraint is unsatisfiable, two when two requirers conflict).
+    std::vector<std::string> deps(conflicted.begin(), conflicted.end());
+    std::sort(deps.begin(), deps.end());
+    for (const auto &d : deps) {
+        std::vector<std::string> pair = conflictPair(d, reachable, assignment, c.registry);
+        if (pair.size() < 1)
+            continue;
+        std::sort(pair.begin(), pair.end());
+        out.conflicts.push_back({pair, d});
+    }
+    std::sort(out.conflicts.begin(), out.conflicts.end(),
+              [](const ConflictItem &a, const ConflictItem &b) {
+                  if (a.dependency != b.dependency)
+                      return a.dependency < b.dependency;
+                  std::string ja, jb;
+                  for (size_t k = 0; k < a.packages.size(); k++) {
+                      if (k)
+                          ja.push_back(',');
+                      ja += a.packages[k];
+                  }
+                  for (size_t k = 0; k < b.packages.size(); k++) {
+                      if (k)
+                          jb.push_back(',');
+                      jb += b.packages[k];
+                  }
+                  return ja < jb;
+              });
+    return out;
 }
 
