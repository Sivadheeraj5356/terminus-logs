+static std::vector<Prim> parseConstraint(std::string s) {
+    s = trim(s);
+    if (s == "*" || s == "" || s == "x") {
+        Ver z;
+        return {{"GTE", z}};
+    }
+    if (s[0] == '^') {
+        auto pr = fill(s.substr(1));
+        Ver lo = pr.first;
+        int arity = pr.second;
+        Ver hi;
+        if (arity == 1) {
+            hi.maj = lo.maj + 1;
+        } else if (arity == 2) {
+            if (lo.maj == 0)
+                hi.min = lo.min + 1;
+            else
+                hi.maj = lo.maj + 1;
+        } else {
+            if (lo.maj == 0) {
+                if (lo.min == 0)
+                    hi.pat = lo.pat + 1;
+                else
+                    hi.min = lo.min + 1;
+            } else {
+                hi.maj = lo.maj + 1;
+            }
+        }
+        return {{"GTE", lo}, {"LT", hi}};
+    }
+    if (s[0] == '~') {
+        auto pr = fill(s.substr(1));
+        Ver lo = pr.first;
+        int arity = pr.second;
+        Ver hi;
+        if (arity == 1) {
+            hi.maj = lo.maj + 1;
+        } else {
+            hi.maj = lo.maj;
+            hi.min = lo.min + 1;
+        }
+        return {{"GTE", lo}, {"LT", hi}};
+    }
+    std::string op, rest;
+    if (s.rfind(">=", 0) == 0) {
+        op = "GTE";
+        rest = s.substr(2);
+    } else if (s.rfind("<=", 0) == 0) {
+        op = "LTE";
+        rest = s.substr(2);
+    } else if (s.rfind(">", 0) == 0) {
+        op = "GT";
+        rest = s.substr(1);
+    } else if (s.rfind("<", 0) == 0) {
+        op = "LT";
+        rest = s.substr(1);
+    } else if (s.rfind("=", 0) == 0) {
+        op = "EQ";
+        rest = s.substr(1);
+    } else {
+        throw std::runtime_error("bad constraint " + s);
+    }
+    auto pr = fill(trim(rest));
+    return {{op, pr.first}};
+}
