+struct Ver {
+    int maj = 0, min = 0, pat = 0;
+    bool hasPre = false;
+    std::vector<std::string> pre;
+};
+
+static Ver parseVersion(const std::string &s) {
+    Ver v;
+    std::string core = s;
+    size_t dash = s.find('-');
+    if (dash != std::string::npos) {
+        core = s.substr(0, dash);
+        v.hasPre = true;
+        v.pre = splitStr(s.substr(dash + 1), '.');
+    }
+    std::vector<std::string> parts = splitStr(core, '.');
+    if (parts.size() > 0)
+        v.maj = toInt(parts[0]);
+    if (parts.size() > 1)
+        v.min = toInt(parts[1]);
+    if (parts.size() > 2)
+        v.pat = toInt(parts[2]);
+    return v;
+}
+
+static int cmpPre(const std::vector<std::string> &a, const std::vector<std::string> &b) {
+    size_t n = std::max(a.size(), b.size());
+    for (size_t i = 0; i < n; i++) {
+        if (i >= a.size())
+            return -1;
+        if (i >= b.size())
+            return 1;
+        const std::string &x = a[i];
+        const std::string &y = b[i];
+        bool xn = isNum(x), yn = isNum(y);
+        if (xn && yn) {
+            int xi = std::atoi(x.c_str()), yi = std::atoi(y.c_str());
+            if (xi != yi)
+                return xi < yi ? -1 : 1;
+        } else if (xn && !yn) {
+            return -1;
+        } else if (yn && !xn) {
+            return 1;
+        } else {
+            if (x != y)
+                return x < y ? -1 : 1;
+        }
+    }
+    return 0;
+}
+
+static int cmpVersion(const Ver &a, const Ver &b) {
+    if (a.maj != b.maj)
+        return a.maj < b.maj ? -1 : 1;
+    if (a.min != b.min)
+        return a.min < b.min ? -1 : 1;
+    if (a.pat != b.pat)
+        return a.pat < b.pat ? -1 : 1;
+    if (!a.hasPre && !b.hasPre)
+        return 0;
+    if (!a.hasPre)
+        return 1;
+    if (!b.hasPre)
+        return -1;
+    return cmpPre(a.pre, b.pre);
+}
+
+static bool coreEq(const Ver &a, const Ver &b) {
+    return a.maj == b.maj && a.min == b.min && a.pat == b.pat;
+}
