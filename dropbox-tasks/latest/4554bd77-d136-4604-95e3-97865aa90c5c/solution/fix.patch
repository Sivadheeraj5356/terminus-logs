+// dfsMin runs only when no conflict-free assignment exists. It searches the whole
+// space of assignments, marking a package conflicted exactly when it has no
+// admissible satisfying version under its currently active constraints, and keeps
+// the outcome with the FEWEST conflicts. A greedy higher version of an earlier
+// package can introduce an avoidable second conflict that a lower version of that
+// same package would remove; because this explores every version choice instead
+// of returning at the first branch that marks something conflicted, it backtracks
+// those earlier choices and reports only the conflicts that are truly unavoidable,
+// yielding the maximal valid install set. Among equally-minimal outcomes it keeps
+// the first found under highest-version-first ordering, so free choices still
+// prefer higher versions.
+static void dfsMin(StrMap assignment, std::set<std::string> conflicted,
+                   const StrMap &requirements, const Registry &reg, int &budget,
+                   std::optional<Outcome> &best) {
+    budget--;
+    if (budget < 0)
+        throw std::runtime_error("resolution budget exhausted");
+    // The conflict set only grows as the search descends, so a branch that has
+    // already accumulated at least as many conflicts as the best complete outcome
+    // can never improve on it.
+    if (best && conflicted.size() >= best->conflicted.size())
+        return;
+    std::vector<std::string> req = requiredSet(assignment, conflicted, requirements, reg);
+    std::string frontier;
+    std::vector<std::vector<Prim>> frRanges;
+    bool found = false;
+    for (const auto &p : req) {
+        std::vector<std::vector<Prim>> ranges = rangesOf(active(p, assignment, requirements, reg));
+        auto it = assignment.find(p);
+        if (it != assignment.end() && validAssigned(p, it->second, ranges, reg))
+            continue;
+        frontier = p;
+        frRanges = ranges;
+        found = true;
+        break;
+    }
+    if (!found) {
+        if (!best || conflicted.size() < best->conflicted.size())
+            best = Outcome{assignment, conflicted};
+        return;
+    }
+    std::vector<std::string> cs = candidates(frontier, frRanges, reg);
+    StrMap base = assignment;
+    base.erase(frontier);
+    for (const auto &cv : cs) {
+        StrMap na = base;
+        na[frontier] = cv;
+        dfsMin(na, conflicted, requirements, reg, budget, best);
+    }
+    if (cs.empty()) {
+        std::set<std::string> nc = conflicted;
+        nc.insert(frontier);
+        dfsMin(base, nc, requirements, reg, budget, best);
+    }
