{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "type": "object",
  "required": [
    "lock_schema_version",
    "repository",
    "revision",
    "source_metadata_digest",
    "transcript_digest",
    "gradle_lock_digest",
    "routes"
  ],
  "properties": {
    "lock_schema_version": {
      "type": "string"
    },
    "repository": {
      "type": "string"
    },
    "revision": {
      "type": "string"
    },
    "source_metadata_digest": {
      "type": "string"
    },
    "transcript_digest": {
      "type": "string"
    },
    "gradle_lock_digest": {
      "type": "string"
    },
    "routes": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "route_id",
          "files"
        ],
        "properties": {
          "route_id": {
            "type": "string"
          },
          "files": {
            "type": "array",
            "items": {
              "type": "object",
              "required": [
                "path",
                "sha256",
                "bytes"
              ],
              "properties": {
                "path": {
                  "type": "string"
                },
                "sha256": {
                  "type": "string"
                },
                "bytes": {
                  "type": "integer"
                }
              }
            }
          }
        }
      }
    }
  }
}
