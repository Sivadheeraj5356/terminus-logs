FROM public.ecr.aws/docker/library/ruby:3.3-slim-bookworm@sha256:e76733e94b3a5893e4a141024ef3a583dc10781dc24becebf74f9c9f9a33e3df

WORKDIR /app

RUN apt-get update && apt-get install -y --no-install-recommends \
    python3=3.11.2-1+b1 \
    python3-venv=3.11.2-1+b1 \
    tmux=3.3a-3 \
    asciinema=2.2.0-1 \
    ca-certificates=20230311+deb12u1 \
    patch=2.7.6-7 \
    && rm -rf /var/lib/apt/lists/*

RUN python3 -m venv /opt/verifier \
    && /opt/verifier/bin/pip install --no-cache-dir pytest==8.4.1 pytest-json-ctrf==0.3.5

ENV PATH=/opt/verifier/bin:${PATH}

COPY Gemfile /app/environment/Gemfile
WORKDIR /app/environment
RUN bundle install --without development test

COPY . /app/environment/
RUN chmod +x /app/environment/pilot/hx_ctl \
    && mkdir -p /app/bin /app/output \
    && ln -sf /app/environment/pilot/hx_ctl /app/bin/hx_ctl

WORKDIR /app
