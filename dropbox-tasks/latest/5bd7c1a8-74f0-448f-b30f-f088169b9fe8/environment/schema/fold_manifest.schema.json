      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "assemble_attestation": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "fold_load_skew": {
      "type": "integer"
    },
    "label_cardinality": {
      "type": "integer"
    },
    "cohort_span_digest": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "balance_coupler": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "kit_closure": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "run_chain_digest": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "class_prior_seal": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "fold_split_witness": {
