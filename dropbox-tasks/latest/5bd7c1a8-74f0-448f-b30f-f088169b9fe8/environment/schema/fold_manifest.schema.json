    "label_coverage_seal": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "holdout_fold_id": {
      "type": "integer"
    },
    "evaluation_seal": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
