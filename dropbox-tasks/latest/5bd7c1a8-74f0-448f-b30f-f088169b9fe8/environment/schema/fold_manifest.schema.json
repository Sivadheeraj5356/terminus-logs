      "pattern": "^[0-9a-f]{64}$"
    },
    "label_pair_cooccurrence": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "balance_drift_witness": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "epoch_manifest_binder": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "holdout_exclusion_seal": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "fold_kit_seal": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "fold_coverage_lattice": {
