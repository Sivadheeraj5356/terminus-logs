{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "route_manifest.schema.json",
  "title": "RouteManifest",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_tag",
    "rooms",
    "moves",
    "api_evidence",
    "rooms_checksum",
    "moves_checksum",
    "evidence_checksum",
    "manifest_checksum"
  ],
  "properties": {
    "schema_tag": {
      "type": "string",
      "const": "route_manifest_v1"
    },
    "rooms": {
      "type": "array",
      "minItems": 2,
      "items": { "type": "string", "minLength": 1 }
    },
    "moves": {
      "type": "array",
      "minItems": 1,
      "items": { "type": "string", "enum": ["N", "S", "E", "W"] }
    },
    "api_evidence": {
      "type": "object",
      "additionalProperties": false,
      "required": ["listen_port", "graph_path", "endpoint", "status_code"],
      "properties": {
        "listen_port": { "type": "integer", "minimum": 1, "maximum": 65535 },
        "graph_path": { "type": "string", "minLength": 1 },
        "endpoint": { "type": "string", "const": "/v1/topology" },
        "status_code": { "type": "integer", "const": 200 }
      }
    },
    "rooms_checksum": {
      "type": "string",
      "pattern": "^[0-9a-f]{16}$"
    },
    "moves_checksum": {
      "type": "string",
      "pattern": "^[0-9a-f]{16}$"
    },
    "evidence_checksum": {
      "type": "string",
      "pattern": "^[0-9a-f]{16}$"
    },
    "manifest_checksum": {
      "type": "string",
      "pattern": "^[0-9a-f]{16}$"
    }
  }
}
