#!/usr/bin/env python3
import argparse
import json
from pathlib import Path


parser = argparse.ArgumentParser()
parser.add_argument("--manifest", required=True)
parser.add_argument("--batch", required=True)
args = parser.parse_args()

data = json.loads(Path(args.manifest).read_text())
rank = int(data.get("probe_rank", 9999))
drift = int(data.get("probe_drift", 0))
anchor = int(data.get("probe_anchor", 0)) & 0xFFFFFFFF
print(f"rank_score={rank} drift={drift} anchor={anchor:08x}")
