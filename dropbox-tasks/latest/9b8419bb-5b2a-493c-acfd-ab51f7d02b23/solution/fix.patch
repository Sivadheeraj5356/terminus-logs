+func combineEvidence(a model.Evidence, b model.Evidence) model.Evidence {
+	out := a
+	if severityRank(b.Status) > severityRank(out.Status) {
+		out.Status = b.Status
+		out.Axis = b.Axis
+		out.Weight = b.Weight
+		out.Note = b.Note
+	} else if severityRank(b.Status) == severityRank(out.Status) {
+		winner := tieEvidence(out, b)
+		out.Axis = winner.Axis
+		out.Weight = winner.Weight
+		out.Note = winner.Note
+	}
+	if a.Source == "independent" || b.Source == "independent" {
+		out.Source = "independent"
+	}
+	if dissentRank(b.Dissent) > dissentRank(out.Dissent) {
+		out.Dissent = b.Dissent
+	}
+	out.Resolved = a.Resolved && b.Resolved
+	if out.Resolved && b.Note != "" {
+		out.Note = b.Note
+	}
+	return out
+}
+
+func tieEvidence(a model.Evidence, b model.Evidence) model.Evidence {
+	aInd := a.Source == "independent"
+	bInd := b.Source == "independent"
+	if aInd && !bInd {
+		return a
+	}
+	if bInd && !aInd {
+		return b
+	}
+	if a.Note < b.Note {
+		return a
+	}
+	if b.Note < a.Note {
+		return b
+	}
+	if a.Weight <= b.Weight {
+		return a
+	}
+	return b
+}
+
+func severityRank(v string) int {
+	switch v {
+	case "ready":
+		return 0
+	case "watch":
+		return 1
+	case "gap":
+		return 2
+	case "blocked":
+		return 3
+	default:
+		return 0
+	}
+}
+
+func dissentRank(v string) int {
+	switch v {
+	case "none", "":
+		return 0
+	case "minor":
+		return 1
+	case "major":
+		return 2
+	case "critical":
+		return 3
+	default:
+		return 0
+	}
+}
