{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "required": [
    "id",
    "epoch",
    "digest",
    "cert",
    "cells"
  ],
  "additionalProperties": false,
  "properties": {
    "id": {
      "type": "string"
    },
    "epoch": {
      "type": "integer"
    },
    "digest": {
      "type": "string",
      "pattern": "^[0-9a-f]{16}$"
    },
    "cert": {
      "type": "string",
      "pattern": "^[0-9a-f]{16}$"
    },
    "cells": {
      "type": "array",
      "items": {
        "type": "integer"
      }
    }
  }
}
